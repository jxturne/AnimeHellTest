@page
@model AnimeHellTest.Pages.AnimeIndexModel
@{
    ViewData["Title"] = "My Anime Collection";
}

<div class="container my-4">
    <h1>🎌 Welcome to Anime Hell V#3</h1>
    
    <!-- Search Bar -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Search MyAnimeList</h5>
            <form method="get" class="row g-3">
                <div class="col-md-10">
                    <input type="text"
                           name="searchQuery"
                           value="@Model.SearchQuery"
                           class="form-control"
                           placeholder="Search for anime..." />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Search</button>
                </div>
            </form>
        </div>
    </div>
    <!-- Refresh Button -->
    <div class="mb-3">
        <a href="/AnimeIndex" class="btn btn-outline-secondary">
            🔄 Refresh Collection
        </a>
    </div>

    <!-- Status Message -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search Results -->
    @if (!string.IsNullOrEmpty(Model.SearchQuery))
    {
        <div class="mb-5">
            <h3>Search Results for "@Model.SearchQuery"</h3>
            
            @if (Model.SearchResults != null && Model.SearchResults.Any())
            {
                <p class="text">Found @Model.SearchResults.Count results</p>
                <div class="row">
                    @foreach (var anime in Model.SearchResults)
                    {
                        <div class="col-md-4 col-lg-3 mb-3">
                            <div class="card h-100 shadow-sm">
                                @if (!string.IsNullOrEmpty(anime.ImageUrl))
                                {
                                    <img src="@anime.ImageUrl" class="card-img-top" alt="@anime.Title" style="height: 300px; object-fit: cover;" />
                                }
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@anime.Title</h5>
                                    <p class="card-text small text-muted flex-grow-1">
                                        @(anime.Description?.Length > 100
                                            ? anime.Description.Substring(0, 100) + "..."
                                            : anime.Description ?? "No description available")
                                    </p>
                                    <div class="mt-2">
                                        @if (!string.IsNullOrEmpty(anime.StudioName))
                                        {
                                            <p class="mb-1 medium"><strong>Studio:</strong> @anime.StudioName</p>
                                        }
                                        @if (anime.Episodes > 0)
                                        {
                                            <p class="mb-1 medium"><strong>Episodes:</strong> @anime.Episodes</p>
                                        }
                                        <span class="badge bg-@(anime.IsCompleted ? "success" : "warning")">
                                            @(anime.IsCompleted ? "Completed" : "Ongoing")
                                        </span>
                                    </div>
                                </div>
                                <div class="card-footer bg-white">
                                    @if (Model.MyAnimes.Any(a => a.MalID == anime.MalID))
                                    {
                                        <button class="btn btn-secondary btn-sm w-100" disabled>
                                            ✓ In Collection
                                        </button>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Import">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="malId" value="@anime.MalID" />
                                            <input type="hidden" name="searchQuery" value="@Model.SearchQuery       " />
                                            <button type="submit" class="btn btn-success btn-sm w-100">
                                                ➕ Add to Collection
                                            </button>
                                        </form>
                                    }
                                    
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <p class="mb-0">No results found for "@Model.SearchQuery". Try a different search term.</p>
                </div>
            }
        </div>
        
    }

    <!-- My Collection Section -->
    <div class="mt-5">
        <h3>📚 My Collection (@Model.MyAnimes.Count anime@(Model.MyAnimes.Count != 1 ? "s" : ""))</h3>
        
        @if (Model.MyAnimes.Any())
        {
            <!-- Collection Control Buttons -->
<div class="mb-3 d-flex gap-2">
    <form method="post" asp-page-handler="ToggleCollection" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-@(Model.ShowCollection ? "primary" : "outline-primary")">
            @(Model.ShowCollection ? "📚 Hide Collection" : "📚 Show Collection")
        </button>
    </form>
    
    @if (Model.MyAnimes.Any())
    {
        <form method="post" asp-page-handler="Clear" class="d-inline" onsubmit="return confirm('⚠️ Are you sure you want to delete ALL anime from your collection? This cannot be undone!');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger">
                🗑️ Clear All
            </button>
        </form>
    }
</div>

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th style="width: 100px;">Image</th>
                            <th>Title</th>
                            <th>Description</th>
                            <th style="width: 150px;">Studio</th>
                            <th style="width: 100px;">Episodes</th>
                            <th style="width: 100px;">Status</th>
                            <th style="width: 150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var anime in Model.MyAnimes)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(anime.ImageUrl))
                                    {
                                        <img src="@anime.ImageUrl" 
                                             alt="@anime.Title" 
                                             class="img-thumbnail" 
                                             style="width: 80px; height: 80px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center" 
                                             style="width: 80px; height: 80px; font-size: 0.7rem;">
                                            No Image
                                        </div>
                                    }
                                </td>
                                <td>
                                    <strong>@anime.Title</strong>
                                </td>
                                <td>
                                    <small class="text-muted">
                                        @(anime.Description?.Length > 150
                                            ? anime.Description.Substring(0, 150) + "..."
                                            : anime.Description ?? "No description available")
                                    </small>
                                </td>
                                <td>@(anime.StudioName ?? "Unknown")</td>
                                <td class="text-center">@anime.Episodes</td>
                                <td>
                                    <span class="badge bg-@(anime.IsCompleted ? "success" : "warning")">
                                        @(anime.IsCompleted ? "Completed" : "Ongoing")
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <form method="post" asp-page-handler="Update" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@anime.ID" />
                                            <input type="hidden" name="malId" value="@anime.MalID" />
                                            <button type="submit" 
                                                    class="btn btn-primary btn-sm" 
                                                    title="Update from MyAnimeList">
                                                🔄
                                            </button>
                                        </form>
                                        <form method="post" asp-page-handler="Delete" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@anime.ID" />
                                            <button type="submit" 
                                                    class="btn btn-danger btn-sm" 
                                                    title="Remove from collection"
                                                    onclick="return confirm('Remove @anime.Title from your collection?');">
                                                🗑️
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <p class="mb-0">Your collection is empty. Search for anime above and add them to your collection!</p>
            </div>
        }
    </div>
</div>